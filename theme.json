{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#0a0a0a"
				},
				{
					"name": "Base 2",
					"slug": "base-2",
					"color": "#141414"
				},
				{
					"name": "Base 3",
					"slug": "base-3",
					"color": "#222222"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#ff2d2d"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#f0f0f0"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#777777"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#ff3c00"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem"
				},
				{
					"name": "X-Large",
					"slug": "x-large",
					"size": "1.75rem"
				},
				{
					"name": "2X-Large",
					"slug": "xx-large",
					"size": "2.5rem"
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "clamp(2.5rem, 6vw, 5rem)"
				}
			]
		},
		"layout": {
			"contentSize": "860px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
			"lineHeight": "1.6"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontWeight": "900",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontWeight": "700"
				},
				"border": {
					"radius": "4px"
				}
			}
		}
	}
}
